# ==============================================================================
# KNOWLEDGE ENGINE BACKEND CONFIGURATION EXAMPLE
# ==============================================================================

# --- Server & Environment ---
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database Configuration (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=knowledge_engine

# --- Administration Interface (pgAdmin 4) ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- AWS & LocalStack Services (S3 Storage & SQS Messaging) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_S3_BUCKET=knowledge-engine-docs
AWS_ENDPOINT_URL=http://localhost:4566

# --- SQS Messaging Queues & Poller Worker Configuration ---
# WORKER_ENABLED is forced by the entrypoint: `pnpm start:worker` / dist/main-worker sets it to true,
# the API (`pnpm dev` / dist/main) sets it to false. Only the worker runs SQS consumers and outbox pollers.
# EMBEDDING_WORKER_ENABLED=false turns off just the embedding consumer inside the worker.
EMBEDDING_WORKER_ENABLED=true
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/knowledge-engine-ingestion-queue
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/knowledge-engine-ingestion-dlq
SQS_EMBEDDING_QUEUE_URL=http://localhost:4566/000000000000/knowledge-engine-embedding-queue
SQS_EMBEDDING_DLQ_URL=http://localhost:4566/000000000000/knowledge-engine-embedding-dlq
SQS_POLL_WAIT_TIME_SECONDS=20
SQS_MAX_NUMBER_OF_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_POLLER_CONCURRENCY=1

# --- Outbox Polling & Transactional Event Dispatcher ---
OUTBOX_POLL_INTERVAL_MS=5000
# Max 10 (SQS batch limit)
OUTBOX_BATCH_SIZE=10
OUTBOX_POLLER_ENABLED=true
OUTBOX_MAX_RETRIES=5

# --- Local File Ingestion & Storage Limits ---
DOCUMENT_TEMP_DIR=./tmp/documents
DOCUMENT_MAX_SIZE_BYTES=104857600
DOCUMENT_TEMP_DISK_LIMIT_BYTES=5368709120

# --- Vector Embedding Service (Ollama Local Model) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
OLLAMA_MODEL=gemma:2b
# Max wait for one embedding batch, or for the first byte of a chat reply
OLLAMA_TIMEOUT_MS=120000

# --- Model Providers (ollama | gemini) ---
# Changing EMBEDDING_PROVIDER means re-embedding every document. Gemini needs GEMINI_API_KEY.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
# GEMINI_API_KEY=

# --- Chat History Window ---
# Only the newest prior messages that fit both limits are resent to the LLM, so long chats never
# outgrow the model's context window. Older turns stay stored and visible in the UI.
CHAT_HISTORY_MAX_MESSAGES=6
CHAT_HISTORY_MAX_CHARS=6000

# --- Metrics ---
# When set (16+ chars), /metrics requires `Authorization: Bearer <METRICS_TOKEN>`
# METRICS_TOKEN=

# --- Distributed Tracing & Telemetry (Jaeger / OpenTelemetry) ---
OTEL_ATTR_SERVICE_VERSION=1.0
OTEL_ATTR_SERVICE_NAME=Knowledge_Engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATIO=1

# --- Resilience & Circuit Breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- Neural Cross-Encoder Reranker (Qwen3-Reranker via Ollama) ---
RERANKING_ENABLED=false
RERANKER_PROVIDER_TYPE=ollama
RERANKER_BASE_URL=http://localhost:11434
RERANKER_ENDPOINT_PATH=/api/generate
RERANKER_MODEL_NAME=qwen3-reranker
RERANKER_TIMEOUT_MS=15000
RERANKER_CANDIDATES_TOP_K=30
RERANKER_FINAL_TOP_K=5